    {
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "nginx_config",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "data": {
              "nginx.conf": "events {}\r\n\r\nhttp {\r\n    server {\r\n        listen 80;\r\n        server_name sso.postech.com.br;\r\n\r\n        location / {\r\n            proxy_pass http://keycloak:8080;\r\n            proxy_set_header Host $host;\r\n            proxy_set_header X-Real-IP $remote_addr;\r\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\r\n            proxy_set_header X-Forwarded-Proto $scheme;\r\n        }\r\n    }\r\n\r\n    server {\r\n        listen 80;\r\n        server_name api.postech.com.br;\r\n\r\n        location / {\r\n            proxy_pass http://app:8080;\r\n            proxy_set_header Host $host;\r\n            proxy_set_header X-Real-IP $remote_addr;\r\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\r\n            proxy_set_header X-Forwarded-Proto $scheme;\r\n        }\r\n    }\r\n}"
            },
            "id": "default/nginx-config",
            "immutable": false,
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
                "generation": 0,
                "labels": null,
                "name": "nginx-config",
                "namespace": "default",
                "resource_version": "1438",
                "uid": "7c0e3428-fe3a-4704-af10-e4bab9a84152"
              }
            ]
          },
          "sensitive_attributes": [],
          "identity_schema_version": 1,
          "identity": {
