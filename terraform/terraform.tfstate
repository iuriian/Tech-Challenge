    {
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "db_init_scripts",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "data": {
              "init.sql": "-- Este script é executado apenas na primeira inicialização do container\r\n-- O banco 'oficina' já é criado automaticamente pela variável POSTGRES_DB\r\n-- Este arquivo pode ser usado para criar tabelas, extensões ou dados iniciais\r\n\r\n-- Exemplo: garantir que o banco existe (redundante, mas seguro)\r\n-- SELECT 'CREATE DATABASE oficina'\r\n-- WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'oficina')\\gexec\r\n\r\nSELECT 'CREATE DATABASE keycloak'\r\n    WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'keycloak')\\gexec\r\n\r\n\\c keycloak\r\n\r\n\r\nSELECT 'CREATE DATABASE oficina'\r\n    WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'oficina')\\gexec\r\n\r\n\\c oficina\r\n\r\nSELECT 'CREATE DATABASE sonarqube'\r\n    WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'sonarqube')\\gexec\r\n\r\n\\c sonarqube\r\n"
            },
            "id": "default/db-init-scripts",
            "immutable": false,
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
                "generation": 0,
                "labels": null,
                "name": "db-init-scripts",
                "namespace": "default",
                "resource_version": "1439",
                "uid": "e17c0a12-babe-4372-b4f9-8dd35386a933"
              }
            ]
          },
          "sensitive_attributes": [],
          "identity_schema_version": 1,
          "identity": {
            "api_version": "v1",
            "kind": "ConfigMap",
            "name": "db-init-scripts",
            "namespace": "default"
          },
          "private": "bnVsbA=="
        }
      ]
    },
