# Copie para terraform.tfvars e ajuste. terraform.tfvars NAO deve ser versionado.

project_id = "seu-project-id"

# Precisam ser identicos as variables do Environment 'staging' no GitHub
zone         = "us-central1-a"
cluster_name = "tech-challenge-staging"

# e2-medium e o minimo que comporta a stack; e2-small deixa a app em Pending
machine_type = "e2-medium"
node_count   = 1
disk_size_gb = 30

# Spot: 60-91% mais barato. A VM pode ser reivindicada e os pods reagendam.
use_spot_vms = true
